#!/usr/bin/env bash
# The repo's pre-push hook: the suite minus the pole and the slow tail.
#
#   Enable once per clone:   git config core.hooksPath hooks
#   Escape hatch:            git push --no-verify
#
# Skipped here, run ALWAYS by CI (`tests.yml` runs the whole suite on
# every push):
#
#   tests/test_parity_corpus.py                      2:02  the exactness oracle
#   test_order_independence.py::...order...asked_for  17.6s
#   test_poke_rate.py::...holds_the_rate_down        11.7s
#   test_potential_delta.py::...is_priced_exactly     6.7s
#   test_potential_delta.py::...error_is_measured     6.4s
#   test_poke_rate.py::...repeatedly[4001]            6.3s
#
# The hook is the fast lane (~70 s), not the record: a regression in the
# slow five is caught at CI before anything merges. What the hook is for
# is the cheap failures -- `test_types`, `test_scale_discipline` -- that
# two red pushes on 2026-09-22 tripped in under a second each.
#
# The hook stands down while a gate or measurement is running -- the
# contention rule: this repo has recorded, twice, that load on the box
# corrupts a timing it is about to quote. A push then goes through with
# CI as its only gate, and says so out loud rather than silently passing.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

if scripts/gate_running.py >/dev/null 2>&1; then
    echo "pre-push: STOOD DOWN -- a gate or measurement is running (contention rule)." >&2
    echo "pre-push: tests.yml is the only gate for this push." >&2
    exit 0
fi

SLOW=(
    --deselect='tests/test_order_independence.py::test_values_do_not_depend_on_the_order_they_are_asked_for'
    --deselect='tests/test_poke_rate.py::test_the_forward_search_is_what_holds_the_rate_down'
    --deselect='tests/test_potential_delta.py::test_one_member_moving_is_priced_exactly'
    --deselect='tests/test_potential_delta.py::test_several_members_moving_is_first_order_and_the_error_is_measured'
    --deselect='tests/test_poke_rate.py::test_a_seat_does_not_poke_battlegrounds_repeatedly[4001]'
)

echo "pre-push: uv run pytest -q (minus the corpus and the slow five)" >&2
uv run pytest -q --ignore=tests/test_parity_corpus.py "${SLOW[@]}"
status=$?
if [ "$status" -ne 0 ]; then
    echo "pre-push: REJECTED (pytest exit $status)." >&2
    echo "pre-push: the corpus and the slow five are CI's; fix or push with --no-verify." >&2
fi
exit "$status"
